# ==========================================
# News Backend API - Environment Variables (.env)
# ==========================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL Example)
# To use MySQL instead of the default H2 database, uncomment the lines below:
# DB_URL=jdbc:mysql://localhost:3306/news_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# JPA_DDL_AUTO=update

# Database Configuration (H2 Default)
DB_URL=jdbc:h2:file:./data/newsdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
JPA_DDL_AUTO=update

# JWT (JSON Web Token) Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Storage Configuration
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB
